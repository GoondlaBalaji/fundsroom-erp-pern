DATABASE_URL="postgresql://username:password@localhost:5433/fundsroom_erp?schema=public"
JWT_SECRET="your_jwt_secret_key"
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Idempotency key TTL in hours (default: 24).
# Controls how long a completed idempotency record replays its stored response.
# After this window the record is expired and eligible for cleanup.
IDEMPOTENCY_TTL_HOURS=24
